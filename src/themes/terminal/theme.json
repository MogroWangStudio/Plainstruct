{
  "id": "terminal",
  "name": "终端",
  "version": "2.2.0",
  "type": "docs",
  "author": "MogroWang Studio",
  "description": "命令行风:等宽排印,暗色窗口,提示符导航。",
  "config": [
    {
      "key": "accentColor",
      "label": "强调色",
      "type": "color",
      "default": "#43d17c"
    },
    {
      "key": "contentWidth",
      "label": "正文宽度(px)",
      "type": "number",
      "default": 780,
      "min": 620,
      "max": 980,
      "step": 20
    },
    {
      "key": "bodyFont",
      "label": "正文字体",
      "type": "select",
      "default": "mono",
      "options": [
        "system",
        "serif",
        "mono",
        "custom"
      ]
    },
    {
      "key": "customFont",
      "label": "自定义字体(font-family)",
      "type": "text",
      "default": "",
      "visibleIf": {
        "key": "bodyFont",
        "equals": "custom"
      }
    },
    {
      "key": "scanline",
      "label": "CRT 扫描线纹理",
      "type": "boolean",
      "default": false
    },
    {
      "key": "showDate",
      "label": "显示文档日期",
      "type": "boolean",
      "default": false
    },
    {
      "key": "showFooterCredit",
      "label": "在底部显示由 Plainstruct 创建",
      "type": "boolean",
      "default": true
    }
  ]
}
