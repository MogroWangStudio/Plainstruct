{
  "id": "terminal",
  "name": "终端",
  "version": "3.6.0",
  "type": "docs",
  "author": "MogroWang Studio",
  "description": "命令行风:等宽排印,暗色窗口,提示符导航。",
  "config": [
    {
      "key": "accentColor",
      "label": "强调色",
      "type": "color",
      "default": "#43d17c",
      "category": "颜色与字体"
    },
    {
      "key": "bodyFont",
      "label": "正文字体",
      "type": "select",
      "default": "mono",
      "options": [
        "system",
        "serif",
        "mono",
        "custom"
      ],
      "category": "颜色与字体"
    },
    {
      "key": "customFont",
      "label": "自定义字体(font-family)",
      "type": "text",
      "default": "",
      "visibleIf": {
        "key": "bodyFont",
        "equals": "custom"
      },
      "category": "颜色与字体"
    },
    {
      "key": "scanline",
      "label": "CRT 扫描线纹理",
      "type": "boolean",
      "default": false,
      "category": "颜色与字体"
    },
    {
      "key": "contentWidth",
      "label": "正文宽度(px)",
      "type": "number",
      "default": 780,
      "min": 620,
      "max": 980,
      "step": 20,
      "category": "布局"
    },
    {
      "key": "showDate",
      "label": "显示文档日期",
      "type": "boolean",
      "default": false,
      "category": "内容显示"
    },
    {
      "key": "showFooterCredit",
      "label": "在底部显示由 Plainstruct 创建",
      "type": "boolean",
      "default": true,
      "category": "内容显示"
    },
    {
      "key": "showAuthor",
      "label": "显示作者署名",
      "type": "boolean",
      "default": true,
      "category": "内容显示",
      "hint": "文档配置头填写了 author 时显示"
    },
    {
      "key": "showAigc",
      "label": "显示 AIGC 声明",
      "type": "boolean",
      "default": true,
      "category": "内容显示",
      "hint": "文档配置头选择了 AIGC 声明时显示"
    }
  ]
}
