{
  "id": "terminal",
  "name": "终端",
  "version": "4.0.0",
  "type": "docs",
  "author": "MogroWang Studio",
  "description": "命令行风:等宽排印,暗色窗口,提示符导航。",
  "config": [
    {
      "key": "accentColor",
      "label": "强调色",
      "type": "color",
      "default": "#43d17c",
      "category": "颜色与字体"
    },
    {
      "key": "bodyFont",
      "label": "正文字体",
      "type": "select",
      "default": "mono",
      "options": [
        "system",
        "serif",
        "mono",
        "custom"
      ],
      "category": "颜色与字体"
    },
    {
      "key": "customFont",
      "label": "自定义字体(font-family)",
      "type": "text",
      "default": "",
      "visibleIf": {
        "key": "bodyFont",
        "equals": "custom"
      },
      "category": "颜色与字体"
    },
    {
      "key": "scanline",
      "label": "CRT 扫描线纹理",
      "type": "boolean",
      "default": false,
      "category": "颜色与字体"
    },
    {
      "key": "fontSizePc",
      "label": "正文字号(桌面端)",
      "type": "number",
      "default": 14,
      "min": 12,
      "max": 22,
      "step": 0.5,
      "category": "颜色与字体"
    },
    {
      "key": "fontSizeM",
      "label": "正文字号(移动端)",
      "type": "number",
      "default": 14,
      "min": 12,
      "max": 20,
      "step": 0.5,
      "category": "颜色与字体",
      "hint": "窗口宽度 ≤900px 时生效"
    },
    {
      "key": "contentWidth",
      "label": "正文宽度(px)",
      "type": "number",
      "default": 780,
      "min": 620,
      "max": 980,
      "step": 20,
      "category": "布局"
    },
    {
      "key": "sidebarWidth",
      "label": "侧栏宽度",
      "type": "number",
      "default": 250,
      "min": 200,
      "max": 360,
      "step": 2,
      "category": "布局"
    },
    {
      "key": "sidebarWidthM",
      "label": "移动端抽屉宽度(%)",
      "type": "number",
      "default": 84,
      "min": 60,
      "max": 100,
      "step": 2,
      "category": "布局",
      "hint": "窗口宽度 ≤900px 时侧栏抽屉按视口百分比显示"
    },
    {
      "key": "pageTransition",
      "label": "页面过渡动画",
      "type": "select",
      "default": "淡入上浮",
      "options": [
        "关闭",
        "淡入",
        "淡入上浮",
        "缩放浮现",
        "滑入",
        "弹性浮现",
        "模糊聚焦",
        "翻页",
        "揭开"
      ],
      "category": "动效"
    },
    {
      "key": "loadingAnim",
      "label": "页面加载动画",
      "type": "select",
      "default": "关闭",
      "options": [
        "关闭",
        "转圈",
        "点点",
        "进度条"
      ],
      "category": "动效"
    },
    {
      "key": "navHover",
      "label": "导航悬停反馈",
      "type": "select",
      "default": "强调色",
      "options": [
        "无",
        "加深",
        "强调色",
        "下划线",
        "底色"
      ],
      "category": "悬停反馈"
    },
    {
      "key": "logoHover",
      "label": "Logo 悬停反馈",
      "type": "select",
      "default": "无",
      "options": [
        "无",
        "淡化",
        "放大",
        "强调色"
      ],
      "category": "悬停反馈"
    },
    {
      "key": "titleHover",
      "label": "站点名悬停反馈",
      "type": "select",
      "default": "强调色",
      "options": [
        "无",
        "淡化",
        "强调色",
        "下划线"
      ],
      "category": "悬停反馈"
    },
    {
      "key": "linkHover",
      "label": "正文链接悬停反馈",
      "type": "select",
      "default": "加深",
      "options": [
        "无",
        "加深",
        "下划线",
        "底色"
      ],
      "category": "悬停反馈"
    },
    {
      "key": "pagerHover",
      "label": "上下页卡片悬停反馈",
      "type": "select",
      "default": "强调色",
      "options": [
        "无",
        "上浮",
        "强调色",
        "底色"
      ],
      "category": "悬停反馈"
    },
    {
      "key": "showDate",
      "label": "显示文档日期",
      "type": "boolean",
      "default": false,
      "category": "内容显示"
    },
    {
      "key": "showFooterCredit",
      "label": "在底部显示由 Plainstruct 创建",
      "type": "boolean",
      "default": true,
      "category": "内容显示"
    },
    {
      "key": "showAuthor",
      "label": "显示作者署名",
      "type": "boolean",
      "default": true,
      "category": "内容显示",
      "hint": "文档配置头填写了 author 时显示"
    },
    {
      "key": "showAigc",
      "label": "显示 AIGC 声明",
      "type": "boolean",
      "default": true,
      "category": "内容显示",
      "hint": "文档配置头选择了 AIGC 声明时显示"
    }
  ]
}
