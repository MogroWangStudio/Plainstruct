{
  "id": "ink",
  "name": "墨阅",
  "version": "2.2.0",
  "type": "docs",
  "author": "MogroWang Studio",
  "description": "报刊衬线风:纸面留白,墨色排印,朱砂点睛。",
  "config": [
    {
      "key": "accentColor",
      "label": "强调色",
      "type": "color",
      "default": "#9a3324"
    },
    {
      "key": "contentWidth",
      "label": "正文宽度(px)",
      "type": "number",
      "default": 720,
      "min": 600,
      "max": 900,
      "step": 20
    },
    {
      "key": "bodyFont",
      "label": "正文字体",
      "type": "select",
      "default": "serif",
      "options": [
        "system",
        "serif",
        "mono",
        "custom"
      ]
    },
    {
      "key": "customFont",
      "label": "自定义字体(font-family)",
      "type": "text",
      "default": "",
      "visibleIf": {
        "key": "bodyFont",
        "equals": "custom"
      }
    },
    {
      "key": "dropCap",
      "label": "首段首字下沉",
      "type": "boolean",
      "default": false
    },
    {
      "key": "pageTransition",
      "label": "页面过渡动画",
      "type": "select",
      "default": "淡入上浮",
      "options": [
        "关闭",
        "淡入",
        "淡入上浮",
        "缩放浮现",
        "滑入",
        "弹性浮现",
        "模糊聚焦",
        "翻页",
        "揭开"
      ]
    },
    {
      "key": "showDate",
      "label": "显示文档日期",
      "type": "boolean",
      "default": false
    },
    {
      "key": "showFooterCredit",
      "label": "在底部显示由 Plainstruct 创建",
      "type": "boolean",
      "default": true
    }
  ]
}
