{
  "id": "ink",
  "name": "墨阅",
  "version": "3.8.0",
  "type": "docs",
  "author": "MogroWang Studio",
  "description": "报刊衬线风:纸面留白,墨色排印,朱砂点睛。",
  "config": [
    {
      "key": "accentColor",
      "label": "强调色",
      "type": "color",
      "default": "#9a3324",
      "category": "颜色与字体"
    },
    {
      "key": "bodyFont",
      "label": "正文字体",
      "type": "select",
      "default": "serif",
      "options": [
        "system",
        "serif",
        "mono",
        "custom"
      ],
      "category": "颜色与字体"
    },
    {
      "key": "customFont",
      "label": "自定义字体(font-family)",
      "type": "text",
      "default": "",
      "visibleIf": {
        "key": "bodyFont",
        "equals": "custom"
      },
      "category": "颜色与字体"
    },
    {
      "key": "contentWidth",
      "label": "正文宽度(px)",
      "type": "number",
      "default": 720,
      "min": 600,
      "max": 900,
      "step": 20,
      "category": "布局"
    },
    {
      "key": "dropCap",
      "label": "首段首字下沉",
      "type": "boolean",
      "default": false,
      "category": "布局"
    },
    {
      "key": "pageTransition",
      "label": "页面过渡动画",
      "type": "select",
      "default": "淡入上浮",
      "options": [
        "关闭",
        "淡入",
        "淡入上浮",
        "缩放浮现",
        "滑入",
        "弹性浮现",
        "模糊聚焦",
        "翻页",
        "揭开"
      ],
      "category": "动效"
    },
    {
      "key": "showDate",
      "label": "显示文档日期",
      "type": "boolean",
      "default": false,
      "category": "内容显示"
    },
    {
      "key": "showFooterCredit",
      "label": "在底部显示由 Plainstruct 创建",
      "type": "boolean",
      "default": true,
      "category": "内容显示"
    },
    {
      "key": "showAuthor",
      "label": "显示作者署名",
      "type": "boolean",
      "default": true,
      "category": "内容显示",
      "hint": "文档配置头填写了 author 时显示"
    },
    {
      "key": "showAigc",
      "label": "显示 AIGC 声明",
      "type": "boolean",
      "default": true,
      "category": "内容显示",
      "hint": "文档配置头选择了 AIGC 声明时显示"
    }
  ]
}
