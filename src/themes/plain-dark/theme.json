{
  "id": "plain-dark",
  "name": "素构 · 暗色",
  "version": "3.4.1",
  "type": "docs",
  "author": "MogroWang Studio",
  "description": "默认暗色主题:暖黑纸感,浅墨强调,系统字体。",
  "config": [
    {
      "key": "accentColor",
      "label": "强调色",
      "type": "color",
      "default": "#e7e5e4",
      "category": "颜色与字体"
    },
    {
      "key": "bodyFont",
      "label": "正文字体",
      "type": "select",
      "default": "system",
      "options": [
        "system",
        "serif",
        "mono",
        "custom"
      ],
      "category": "颜色与字体"
    },
    {
      "key": "customFont",
      "label": "自定义字体(font-family)",
      "type": "text",
      "default": "",
      "visibleIf": {
        "key": "bodyFont",
        "equals": "custom"
      },
      "category": "颜色与字体"
    },
    {
      "key": "sidebarWidth",
      "label": "侧栏宽度",
      "type": "number",
      "default": 260,
      "min": 200,
      "max": 360,
      "step": 10,
      "category": "布局"
    },
    {
      "key": "pageTransition",
      "label": "页面过渡动画",
      "type": "select",
      "default": "淡入上浮",
      "options": [
        "关闭",
        "淡入",
        "淡入上浮",
        "缩放浮现",
        "滑入",
        "弹性浮现",
        "模糊聚焦",
        "翻页",
        "揭开"
      ],
      "category": "动效"
    },
    {
      "key": "showDate",
      "label": "显示文档日期",
      "type": "boolean",
      "default": false,
      "category": "内容显示"
    },
    {
      "key": "showDescription",
      "label": "显示站点描述",
      "type": "boolean",
      "default": true,
      "category": "内容显示"
    },
    {
      "key": "showFooterCredit",
      "label": "在底部显示由 Plainstruct 创建",
      "type": "boolean",
      "default": true,
      "category": "内容显示"
    }
  ]
}
