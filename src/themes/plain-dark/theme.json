{
  "id": "plain-dark",
  "name": "素构 · 暗色",
  "version": "4.0.0",
  "type": "docs",
  "author": "MogroWang Studio",
  "description": "默认暗色主题：暖黑纸感，浅墨强调，系统字体。",
  "config": [
    {
      "key": "showLogoPc",
      "label": "显示站点 Logo（桌面端）",
      "type": "boolean",
      "default": true,
      "category": "站点标识"
    },
    {
      "key": "showLogoM",
      "label": "显示站点 Logo（移动端）",
      "type": "boolean",
      "default": true,
      "category": "站点标识",
      "hint": "窗口宽度 ≤900px 时生效"
    },
    {
      "key": "showTitlePc",
      "label": "显示站点标题（桌面端）",
      "type": "boolean",
      "default": true,
      "category": "站点标识"
    },
    {
      "key": "showTitleM",
      "label": "显示站点标题（移动端）",
      "type": "boolean",
      "default": true,
      "category": "站点标识",
      "hint": "窗口宽度 ≤900px 时生效"
    },
    {
      "key": "logoSizePc",
      "label": "Logo 大小（桌面端）",
      "type": "number",
      "default": 28,
      "min": 16,
      "max": 48,
      "step": 1,
      "category": "站点标识"
    },
    {
      "key": "logoSizeM",
      "label": "Logo 大小（移动端）",
      "type": "number",
      "default": 22,
      "min": 16,
      "max": 40,
      "step": 1,
      "category": "站点标识",
      "hint": "窗口宽度 ≤900px 时生效"
    },
    {
      "key": "logoPosPc",
      "label": "Logo 位置（桌面端）",
      "type": "select",
      "default": "标题左侧",
      "options": [
        "标题左侧",
        "标题上方"
      ],
      "category": "站点标识"
    },
    {
      "key": "logoPosM",
      "label": "Logo 位置（移动端）",
      "type": "select",
      "default": "标题左侧",
      "options": [
        "标题左侧",
        "标题上方"
      ],
      "category": "站点标识",
      "hint": "窗口宽度 ≤900px 时生效"
    },
    {
      "key": "accentColor",
      "label": "强调色",
      "type": "color",
      "default": "#e7e5e4",
      "category": "颜色与字体"
    },
    {
      "key": "bodyFont",
      "label": "正文字体",
      "type": "select",
      "default": "system",
      "options": [
        "system",
        "serif",
        "mono",
        "custom"
      ],
      "category": "颜色与字体"
    },
    {
      "key": "customFont",
      "label": "自定义字体（font-family）",
      "type": "text",
      "default": "",
      "visibleIf": {
        "key": "bodyFont",
        "equals": "custom"
      },
      "category": "颜色与字体"
    },
    {
      "key": "fontSizePc",
      "label": "正文字号（桌面端）",
      "type": "number",
      "default": 15.5,
      "min": 12,
      "max": 22,
      "step": 0.5,
      "category": "颜色与字体"
    },
    {
      "key": "fontSizeM",
      "label": "正文字号（移动端）",
      "type": "number",
      "default": 15.5,
      "min": 12,
      "max": 20,
      "step": 0.5,
      "category": "颜色与字体",
      "hint": "窗口宽度 ≤900px 时生效"
    },
    {
      "key": "sidebarWidth",
      "label": "侧栏宽度",
      "type": "number",
      "default": 260,
      "min": 200,
      "max": 360,
      "step": 10,
      "category": "布局"
    },
    {
      "key": "sidebarWidthM",
      "label": "移动端抽屉宽度（%）",
      "type": "number",
      "default": 84,
      "min": 60,
      "max": 100,
      "step": 2,
      "category": "布局",
      "hint": "窗口宽度 ≤900px 时侧栏抽屉按视口百分比显示"
    },
    {
      "key": "sidebarTogglePc",
      "label": "折叠开关位置（桌面端）",
      "type": "select",
      "default": "侧栏边缘",
      "options": [
        "侧栏边缘",
        "侧栏顶部",
        "侧栏底部",
        "隐藏"
      ],
      "category": "布局",
      "hint": "侧栏右缘滑出式开关的贴附位置；「隐藏」时不显示开关"
    },
    {
      "key": "sidebarToggleM",
      "label": "折叠开关位置（移动端）",
      "type": "select",
      "default": "抽屉顶部",
      "options": [
        "抽屉顶部",
        "隐藏"
      ],
      "category": "布局",
      "hint": "窗口宽度 ≤900px 时抽屉头部的收起按钮；「隐藏」时通过点击遮罩关闭抽屉"
    },
    {
      "key": "contentWidth",
      "label": "正文宽度（px）",
      "type": "number",
      "default": 760,
      "min": 560,
      "max": 960,
      "step": 20,
      "category": "布局"
    },
    {
      "key": "pageTransition",
      "label": "页面过渡动画",
      "type": "select",
      "default": "淡入上浮",
      "options": [
        "关闭",
        "淡入",
        "淡入上浮",
        "缩放浮现",
        "滑入",
        "弹性浮现",
        "模糊聚焦",
        "翻页",
        "揭开"
      ],
      "category": "动效"
    },
    {
      "key": "loadingAnim",
      "label": "页面加载动画",
      "type": "select",
      "default": "关闭",
      "options": [
        "关闭",
        "转圈",
        "点点",
        "进度条"
      ],
      "category": "动效"
    },
    {
      "key": "navHover",
      "label": "导航悬停反馈",
      "type": "select",
      "default": "底色",
      "options": [
        "无",
        "加深",
        "强调色",
        "下划线",
        "底色"
      ],
      "category": "悬停反馈"
    },
    {
      "key": "navCurrent",
      "label": "当前文档效果",
      "type": "select",
      "default": "默认",
      "options": [
        "默认",
        "无",
        "底色",
        "强调色",
        "加粗",
        "下划线"
      ],
      "category": "悬停反馈",
      "hint": "当前文档在侧栏导航中的显示效果，「默认」保持主题原样式"
    },
    {
      "key": "logoHover",
      "label": "Logo 悬停反馈",
      "type": "select",
      "default": "放大",
      "options": [
        "无",
        "淡化",
        "放大",
        "强调色"
      ],
      "category": "悬停反馈"
    },
    {
      "key": "titleHover",
      "label": "站点名悬停反馈",
      "type": "select",
      "default": "强调色",
      "options": [
        "无",
        "淡化",
        "强调色",
        "下划线"
      ],
      "category": "悬停反馈"
    },
    {
      "key": "linkHover",
      "label": "正文链接悬停反馈",
      "type": "select",
      "default": "下划线",
      "options": [
        "无",
        "下划线",
        "底色"
      ],
      "category": "悬停反馈"
    },
    {
      "key": "pagerHover",
      "label": "上下页卡片悬停反馈",
      "type": "select",
      "default": "上浮",
      "options": [
        "无",
        "上浮",
        "强调色",
        "底色"
      ],
      "category": "悬停反馈"
    },
    {
      "key": "showDate",
      "label": "显示文档日期",
      "type": "boolean",
      "default": false,
      "category": "内容显示"
    },
    {
      "key": "showDescription",
      "label": "显示站点描述",
      "type": "boolean",
      "default": true,
      "category": "内容显示"
    },
    {
      "key": "showFooterCredit",
      "label": "在底部显示由 Plainstruct 创建",
      "type": "boolean",
      "default": true,
      "category": "内容显示"
    },
    {
      "key": "showAuthor",
      "label": "显示作者署名",
      "type": "boolean",
      "default": true,
      "category": "内容显示",
      "hint": "文档配置头填写了 author 时显示"
    },
    {
      "key": "showAigc",
      "label": "显示 AIGC 声明",
      "type": "boolean",
      "default": true,
      "category": "内容显示",
      "hint": "文档配置头选择了 AIGC 声明时显示"
    },
    {
      "key": "footerNote",
      "label": "页脚说明",
      "type": "text",
      "default": "",
      "category": "页脚",
      "hint": "显示在每页底部的一行文字，留空不显示"
    },
    {
      "key": "footerBuild",
      "label": "显示构建版本与日期",
      "type": "boolean",
      "default": false,
      "category": "页脚"
    },
    {
      "key": "footerBuildFormat",
      "label": "构建信息格式",
      "type": "text",
      "default": "构建于 {date} {time}",
      "tokens": [
        "{version}",
        "{date}",
        "{time}"
      ],
      "visibleIf": {
        "key": "footerBuild",
        "equals": true
      },
      "category": "页脚",
      "hint": "点击令牌按钮插入占位符，构建时自动替换为实际值"
    },
    {
      "key": "footerLinks",
      "label": "友情链接",
      "type": "links",
      "default": "",
      "category": "页脚",
      "hint": "逐条添加名称、链接与图标（图标可选）"
    }
  ]
}
