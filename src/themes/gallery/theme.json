{
  "id": "gallery",
  "name": "画廊",
  "version": "4.0.0",
  "type": "docs",
  "author": "MogroWang Studio",
  "description": "卡片现代风：浮卡分层，大圆角，陶土暖橘点睛。",
  "config": [
    {
      "key": "accentColor",
      "label": "强调色",
      "type": "color",
      "default": "#c8553d",
      "category": "颜色与字体"
    },
    {
      "key": "bodyFont",
      "label": "正文字体",
      "type": "select",
      "default": "system",
      "options": [
        "system",
        "serif",
        "mono",
        "custom"
      ],
      "category": "颜色与字体"
    },
    {
      "key": "customFont",
      "label": "自定义字体（font-family）",
      "type": "text",
      "default": "",
      "visibleIf": {
        "key": "bodyFont",
        "equals": "custom"
      },
      "category": "颜色与字体"
    },
    {
      "key": "fontSizePc",
      "label": "正文字号（桌面端）",
      "type": "number",
      "default": 15.5,
      "min": 12,
      "max": 22,
      "step": 0.5,
      "category": "颜色与字体"
    },
    {
      "key": "fontSizeM",
      "label": "正文字号（移动端）",
      "type": "number",
      "default": 15.5,
      "min": 12,
      "max": 20,
      "step": 0.5,
      "category": "颜色与字体",
      "hint": "窗口宽度 ≤900px 时生效"
    },
    {
      "key": "contentWidth",
      "label": "正文宽度（px）",
      "type": "number",
      "default": 740,
      "min": 600,
      "max": 920,
      "step": 20,
      "category": "布局"
    },
    {
      "key": "sidebarWidth",
      "label": "侧栏宽度",
      "type": "number",
      "default": 256,
      "min": 200,
      "max": 360,
      "step": 2,
      "category": "布局"
    },
    {
      "key": "sidebarWidthM",
      "label": "移动端抽屉宽度（%）",
      "type": "number",
      "default": 84,
      "min": 60,
      "max": 100,
      "step": 2,
      "category": "布局",
      "hint": "窗口宽度 ≤900px 时侧栏抽屉按视口百分比显示"
    },
    {
      "key": "pageTransition",
      "label": "页面过渡动画",
      "type": "select",
      "default": "淡入上浮",
      "options": [
        "关闭",
        "淡入",
        "淡入上浮",
        "缩放浮现",
        "滑入",
        "弹性浮现",
        "模糊聚焦",
        "翻页",
        "揭开"
      ],
      "category": "动效"
    },
    {
      "key": "loadingAnim",
      "label": "页面加载动画",
      "type": "select",
      "default": "关闭",
      "options": [
        "关闭",
        "转圈",
        "点点",
        "进度条"
      ],
      "category": "动效"
    },
    {
      "key": "navHover",
      "label": "导航悬停反馈",
      "type": "select",
      "default": "底色",
      "options": [
        "无",
        "加深",
        "强调色",
        "下划线",
        "底色"
      ],
      "category": "悬停反馈"
    },
    {
      "key": "logoHover",
      "label": "Logo 悬停反馈",
      "type": "select",
      "default": "无",
      "options": [
        "无",
        "淡化",
        "放大",
        "强调色"
      ],
      "category": "悬停反馈"
    },
    {
      "key": "titleHover",
      "label": "站点名悬停反馈",
      "type": "select",
      "default": "强调色",
      "options": [
        "无",
        "淡化",
        "强调色",
        "下划线"
      ],
      "category": "悬停反馈"
    },
    {
      "key": "linkHover",
      "label": "正文链接悬停反馈",
      "type": "select",
      "default": "下划线",
      "options": [
        "无",
        "下划线",
        "底色"
      ],
      "category": "悬停反馈"
    },
    {
      "key": "pagerHover",
      "label": "上下页卡片悬停反馈",
      "type": "select",
      "default": "上浮",
      "options": [
        "无",
        "上浮",
        "强调色",
        "底色"
      ],
      "category": "悬停反馈"
    },
    {
      "key": "showDate",
      "label": "显示文档日期",
      "type": "boolean",
      "default": false,
      "category": "内容显示"
    },
    {
      "key": "showFooterCredit",
      "label": "在底部显示由 Plainstruct 创建",
      "type": "boolean",
      "default": true,
      "category": "内容显示"
    },
    {
      "key": "showAuthor",
      "label": "显示作者署名",
      "type": "boolean",
      "default": true,
      "category": "内容显示",
      "hint": "文档配置头填写了 author 时显示"
    },
    {
      "key": "showAigc",
      "label": "显示 AIGC 声明",
      "type": "boolean",
      "default": true,
      "category": "内容显示",
      "hint": "文档配置头选择了 AIGC 声明时显示"
    },
    {
      "key": "footerNote",
      "label": "页脚说明",
      "type": "text",
      "default": "",
      "category": "页脚",
      "hint": "显示在每页底部的一行文字，留空不显示"
    },
    {
      "key": "footerBuild",
      "label": "显示构建版本与日期",
      "type": "boolean",
      "default": false,
      "category": "页脚"
    },
    {
      "key": "footerBuildFormat",
      "label": "构建信息格式",
      "type": "text",
      "default": "构建于 {date} {time}",
      "tokens": [
        "{version}",
        "{date}",
        "{time}"
      ],
      "visibleIf": {
        "key": "footerBuild",
        "equals": true
      },
      "category": "页脚",
      "hint": "点击令牌按钮插入占位符，构建时自动替换为实际值"
    },
    {
      "key": "footerLinks",
      "label": "友情链接",
      "type": "textarea",
      "default": "",
      "category": "页脚",
      "hint": "每行一条：名称|链接|图标地址（图标可选）"
    }
  ]
}
