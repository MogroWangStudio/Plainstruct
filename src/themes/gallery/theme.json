{
  "id": "gallery",
  "name": "画廊",
  "version": "2.1.0",
  "type": "docs",
  "author": "MogroWang Studio",
  "description": "卡片现代风:浮卡分层,大圆角,陶土暖橘点睛。",
  "config": [
    {
      "key": "accentColor",
      "label": "强调色",
      "type": "color",
      "default": "#c8553d"
    },
    {
      "key": "contentWidth",
      "label": "正文宽度(px)",
      "type": "number",
      "default": 740,
      "min": 600,
      "max": 920,
      "step": 20
    },
    {
      "key": "bodyFont",
      "label": "正文字体",
      "type": "select",
      "default": "system",
      "options": [
        "system",
        "serif",
        "mono",
        "custom"
      ]
    },
    {
      "key": "customFont",
      "label": "自定义字体(font-family)",
      "type": "text",
      "default": "",
      "visibleIf": {
        "key": "bodyFont",
        "equals": "custom"
      }
    },
    {
      "key": "showDate",
      "label": "显示文档日期",
      "type": "boolean",
      "default": false
    },
    {
      "key": "showFooterCredit",
      "label": "在底部显示由 Plainstruct 创建",
      "type": "boolean",
      "default": true
    }
  ]
}
