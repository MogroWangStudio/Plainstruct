<!doctype html>
<html lang="{{#if site.locale}}{{site.locale}}{{else}}zh-CN{{/if}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{#if page.fullTitle}}{{page.fullTitle}}{{else}}{{site.name}}{{/if}}</title>
  {{#if site.description}}<meta name="description" content="{{site.description}}">{{/if}}
  {{#if site.logo}}<link rel="icon" href="{{site.logo}}">{{/if}}
  <style>
    :root {
      --ps-accent: {{config.accentColor}};
      --ps-doc-w: {{config.contentWidth}}px;
      --ps-sidebar-w: {{config.sidebarWidth}}px;
      --ps-drawer-w: {{config.sidebarWidthM}}vw;
    }
  </style>

  <link rel="stylesheet" href="{{asset "assets/style.css"}}">
  <!-- 4.0.0 正文字号双端独立:置于主题样式之后,桌面/移动(≤900px)分别生效 -->
  <style>
    body {
      font-size: {{config.fontSizePc}}px;
    }

    @media (max-width: 900px) {
      body {
        font-size: {{config.fontSizeM}}px;
      }
    }
  </style>
</head>
  <body class="gallery font-{{config.bodyFont}}"{{#if (eq config.pageTransition "淡入")}} ps-anim-fade{{/if}}{{#if (eq config.pageTransition "淡入上浮")}} ps-anim-rise{{/if}}{{#if (eq config.pageTransition "缩放浮现")}} ps-anim-zoom{{/if}}{{#if (eq config.pageTransition "滑入")}} ps-anim-slide{{/if}}{{#if (eq config.pageTransition "弹性浮现")}} ps-anim-spring{{/if}}{{#if (eq config.pageTransition "模糊聚焦")}} ps-anim-blur{{/if}}{{#if (eq config.pageTransition "翻页")}} ps-anim-flip{{/if}}{{#if (eq config.pageTransition "揭开")}} ps-anim-wipe{{/if}}"{{#if (eq config.bodyFont "custom")}} style="--ps-font-body: {{config.customFont}}"{{/if}} data-hv-nav="{{config.navHover}}" data-hv-logo="{{config.logoHover}}" data-hv-title="{{config.titleHover}}" data-hv-link="{{config.linkHover}}" data-hv-pager="{{config.pagerHover}}" data-loading="{{config.loadingAnim}}">
  {{#unless (eq config.loadingAnim "关闭")}}<div class="ps-loader" aria-hidden="true"><span class="ps-loader-spin"></span></div>{{/unless}}
  <!-- 移动端顶栏:菜单按钮 + 当前页路径 + 站点标识(桌面端隐藏) -->
  <header class="ps-topbar">
    <button class="ps-menu-btn" type="button" aria-label="文档列表" aria-expanded="false" aria-controls="ps-sidebar">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <path d="M2.5 4.5h13M2.5 9h13M2.5 13.5h13" />
      </svg>
    </button>
    <!-- 当前页路径(仅移动端显示) -->
    <nav class="ps-crumbs" aria-label="当前页路径">
      {{#each page.crumbs}}<span class="ps-crumb-item">{{this}}</span><span class="ps-crumb-sep">/</span>{{/each}}
      <span class="ps-crumb-item ps-crumb-current">{{page.title}}</span>
    </nav>
    <a class="ps-topbar-brand" href="{{asset "index.html"}}">
      {{#if site.logo}}<img class="ps-logo" src="{{site.logo}}" alt="{{site.name}}">{{/if}}
      <span class="ps-site-name">{{site.name}}</span>
    </a>
  </header>
  <div class="ps-mask" aria-hidden="true"></div>
  <div class="ps-shell">
    <aside class="ps-sidebar" id="ps-sidebar">
      <a class="ps-site" href="{{asset "index.html"}}">
        {{#if site.logo}}<img class="ps-logo" src="{{site.logo}}" alt="{{site.name}}">{{/if}}
        <span class="ps-site-name">{{site.name}}</span>
      </a>
      {{#if site.description}}<p class="ps-site-desc">{{site.description}}</p>{{/if}}
      <nav class="ps-nav" aria-label="文档导航">{{> nav}}</nav>
    </aside>
    <main class="ps-main">
      {{> page}}
      {{#if (or config.footerNote config.footerBuild config.showFooterCredit page.footerLinks.length)}}
        <footer class="ps-footer">
          {{#if config.footerNote}}<p class="ps-footer-note">{{config.footerNote}}</p>{{/if}}
          {{#if page.footerLinks.length}}<nav class="ps-footer-links" aria-label="友情链接">{{#each page.footerLinks}}<a class="ps-footer-link" href="{{this.url}}" target="_blank" rel="noopener">{{#if this.icon}}<img class="ps-footer-link-icon" src="{{this.icon}}" alt="" loading="lazy">{{/if}}<span>{{this.name}}</span></a>{{/each}}</nav>{{/if}}
          {{#if config.footerBuild}}{{#if page.build}}<p class="ps-footer-build">{{page.build.text}}</p>{{/if}}{{/if}}
          {{#if config.showFooterCredit}}<a class="ps-footer-credit" href="https://github.com/MogroWang/Plainstruct" target="_blank" rel="noopener">由 Plainstruct 创建</a>{{/if}}
        </footer>
      {{/if}}
    </main>
  </div>
  <script>
    (function () {
      var btn = document.querySelector(".ps-menu-btn");
      var sidebar = document.querySelector(".ps-sidebar");
      var mask = document.querySelector(".ps-mask");
      if (!btn || !sidebar || !mask) return;
      function setDrawer(open) {
        sidebar.classList.toggle("open", open);
        mask.classList.toggle("show", open);
        btn.setAttribute("aria-expanded", open ? "true" : "false");
      }
      btn.addEventListener("click", function () {
        setDrawer(!sidebar.classList.contains("open"));
      });
      mask.addEventListener("click", function () {
        setDrawer(false);
      });
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") setDrawer(false);
      });
      sidebar.addEventListener("click", function (e) {
        if (e.target instanceof Element && e.target.closest("a")) setDrawer(false);
      });
    })();
    (function () {
      /* 侧栏目录折叠:默认收起;点击展开并记忆,只有用户主动点击才会收起 */
      var navEl = document.querySelector(".ps-nav");
      if (!navEl) return;
      var NAV_KEY = "ps-nav-open";
      var openSet;
      try {
        var raw = JSON.parse(sessionStorage.getItem(NAV_KEY) || "[]");
        openSet = new Set(Array.isArray(raw) ? raw : []);
      } catch (err) {
        openSet = new Set();
      }
      var saveOpen = function () {
        try { sessionStorage.setItem(NAV_KEY, JSON.stringify(Array.from(openSet))); } catch (err) {}
      };
      var expand = function (li, persist) {
        li.classList.add("open");
        var caret = li.querySelector(".ps-nav-caret");
        if (caret) caret.setAttribute("aria-expanded", "true");
        var id = li.getAttribute("data-nav-id");
        if (persist && id) { openSet.add(id); saveOpen(); }
      };
      var collapse = function (li) {
        li.classList.remove("open");
        var caret = li.querySelector(".ps-nav-caret");
        if (caret) caret.setAttribute("aria-expanded", "false");
        var id = li.getAttribute("data-nav-id");
        if (id) { openSet.delete(id); saveOpen(); }
      };
      var items = navEl.querySelectorAll(".ps-nav-item[data-nav-id]");
      Array.prototype.forEach.call(items, function (li) {
        if (openSet.has(li.getAttribute("data-nav-id"))) expand(li, false);
      });
      /* 当前页的祖先目录自动展开(不写入记忆,用户仍可手动收起) */
      var current = navEl.querySelector("a.current, .ps-nav-dir.current");
      var node = current ? current.parentElement : null;
      while (node && node !== navEl) {
        if (node.classList && node.classList.contains("ps-nav-item")) expand(node, false);
        node = node.parentElement;
      }
      navEl.addEventListener("click", function (e) {
        if (!(e.target instanceof Element)) return;
        var caret = e.target.closest(".ps-nav-caret");
        if (caret) {
          var li = caret.closest(".ps-nav-item");
          if (!li) return;
          if (li.classList.contains("open")) collapse(li);
          else expand(li, true);
          return;
        }
        /* 点击查看文件夹时自动展开,之后保持展开 */
        var dirLink = e.target.closest("a.ps-nav-dir");
        if (dirLink) {
          var li2 = dirLink.closest(".ps-nav-item");
          if (li2 && !li2.classList.contains("open")) expand(li2, true);
        }
      });
    })();
  </script>
</body>
</html>
