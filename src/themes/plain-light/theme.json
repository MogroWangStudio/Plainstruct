{
  "id": "plain-light",
  "name": "素构 · 浅色",
  "version": "2.2.0",
  "type": "docs",
  "author": "MogroWang Studio",
  "description": "默认浅色主题:灰白纸感,墨色强调,系统字体。",
  "config": [
    {
      "key": "accentColor",
      "label": "强调色",
      "type": "color",
      "default": "#333333"
    },
    {
      "key": "sidebarWidth",
      "label": "侧栏宽度",
      "type": "number",
      "default": 260,
      "min": 200,
      "max": 360,
      "step": 10
    },
    {
      "key": "bodyFont",
      "label": "正文字体",
      "type": "select",
      "default": "system",
      "options": [
        "system",
        "serif",
        "mono",
        "custom"
      ]
    },
    {
      "key": "customFont",
      "label": "自定义字体(font-family)",
      "type": "text",
      "default": "",
      "visibleIf": {
        "key": "bodyFont",
        "equals": "custom"
      }
    },
    {
      "key": "pageTransition",
      "label": "页面过渡动画",
      "type": "select",
      "default": "淡入上浮",
      "options": [
        "关闭",
        "淡入",
        "淡入上浮",
        "缩放浮现",
        "滑入",
        "弹性浮现",
        "模糊聚焦",
        "翻页",
        "揭开"
      ]
    },
    {
      "key": "showDate",
      "label": "显示文档日期",
      "type": "boolean",
      "default": false
    },
    {
      "key": "showDescription",
      "label": "显示站点描述",
      "type": "boolean",
      "default": true
    },
    {
      "key": "showFooterCredit",
      "label": "在底部显示由 Plainstruct 创建",
      "type": "boolean",
      "default": true
    }
  ]
}
