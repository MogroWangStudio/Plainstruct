{{#if page.isHome}}
<section class="blog-home">
  {{#if page.content}}<div class="blog-home-body">{{{page.content}}}</div>{{/if}}
  {{#if page.postGroups}}
    {{#each page.postGroups}}
    <section class="blog-group">
      <h2 class="blog-group-title">{{#if this.url}}<a href="{{this.url}}">{{this.title}}</a>{{else}}{{this.title}}{{/if}}</h2>
      <div class="blog-stream">
        {{#each this.posts}}{{> post-entry}}{{/each}}
      </div>
      {{#if this.total}}{{#if this.url}}<div class="blog-group-more"><a class="blog-group-more-link" href="{{this.url}}">查看更多 →</a></div>{{/if}}{{/if}}
    </section>
    {{/each}}
  {{else}}
  {{#if posts}}
    <div class="blog-stream">
      {{#each posts}}{{> post-entry}}{{/each}}
    </div>
  {{/if}}
  {{/if}}
  {{#if page.pagination}}
    <nav class="blog-pagination" aria-label="分页">
      {{#if page.pagination.prevUrl}}
        <a class="blog-page-step" href="{{page.pagination.prevUrl}}">← 上一页</a>
      {{else}}
        <span class="blog-page-step is-disabled">← 上一页</span>
      {{/if}}
      <span class="blog-page-nums">
        {{#each page.pagination.pages}}
          {{#if this.current}}
            <span class="blog-page-num is-current" aria-current="page">{{this.n}}</span>
          {{else}}
            <a class="blog-page-num" href="{{this.url}}">{{this.n}}</a>
          {{/if}}
        {{/each}}
      </span>
      {{#if page.pagination.nextUrl}}
        <a class="blog-page-step" href="{{page.pagination.nextUrl}}">下一页 →</a>
      {{else}}
        <span class="blog-page-step is-disabled">下一页 →</span>
      {{/if}}
    </nav>
  {{/if}}
</section>
{{else if page.isArchive}}
<section class="blog-archive">
  <header class="blog-archive-head">
    <h1 class="blog-archive-title">{{page.title}}</h1>
  </header>
  <div class="blog-archive-tabs" role="tablist">
    <button type="button" data-view="list" class="is-active">列表</button>
    <button type="button" data-view="cats">分类</button>
    <button type="button" data-view="cards">卡片</button>
  </div>
  <div class="blog-archive-pane" data-pane="list">
    {{#each page.archive.years}}
    <section class="blog-archive-year">
      <h2>{{#if this.year}}{{this.year}}{{else}}未注明日期{{/if}}</h2>
      <ul>
        {{#each this.posts}}
        <li><a href="{{this.url}}">{{this.title}}</a>{{#if this.date}}<time>{{this.date}}</time>{{/if}}</li>
        {{/each}}
      </ul>
    </section>
    {{/each}}
  </div>
  <div class="blog-archive-pane" data-pane="cats" hidden>
    {{#each page.archive.groups}}
    <section class="blog-archive-cat">
      <h2>{{#if this.url}}<a href="{{this.url}}">{{this.title}}</a>{{else}}{{this.title}}{{/if}}</h2>
      <ul>
        {{#each this.posts}}
        <li><a href="{{this.url}}">{{this.title}}</a>{{#if this.date}}<time>{{this.date}}</time>{{/if}}</li>
        {{/each}}
      </ul>
    </section>
    {{/each}}
  </div>
  <div class="blog-archive-pane" data-pane="cards" hidden>
    <div class="blog-stream">
      {{#each page.archive.posts}}{{> post-entry}}{{/each}}
    </div>
  </div>
</section>
{{else}}
  {{#if page.folderPosts}}
  <section class="blog-folder" data-folder-view="{{page.folderView}}">
    <header class="blog-folder-head">
      <h1 class="blog-folder-title">{{page.title}}</h1>
      <div class="blog-folder-tabs" role="tablist">
        <button type="button" data-fview="stream">卡片流</button>
        <button type="button" data-fview="list">目录</button>
      </div>
    </header>
    <div class="blog-folder-pane" data-fpane="stream"{{#if (eq page.folderView "list")}} hidden{{/if}}>
      <input class="blog-folder-filter" type="search" placeholder="筛选文章…" aria-label="筛选文章">
      <div class="blog-stream">
        {{#each page.folderPosts}}{{> post-entry}}{{/each}}
      </div>
    </div>
    <div class="blog-folder-pane" data-fpane="list"{{#unless (eq page.folderView "list")}} hidden{{/unless}}>
      <div class="blog-folder-list">{{{page.folderListHtml}}}</div>
    </div>
  </section>
  {{else}}
  <article class="blog-post">
  <header class="blog-post-head">
    {{#if page.title}}<h1 class="blog-post-title">{{page.title}}</h1>{{/if}}
    <div class="blog-post-meta">{{#if config.showDate}}{{#if page.date}}<time class="blog-post-date">{{page.date}}</time>{{/if}}{{/if}}{{#if config.showAuthor}}{{#if page.author}}<span class="ps-doc-author">{{page.author}}</span>{{/if}}{{/if}}{{#if config.showAigc}}{{#if page.aigc}}<span class="ps-aigc" data-aigc="{{page.aigc}}">{{#if (eq page.aigc "present")}}本文由 AI 辅助生成{{else}}本文无任何 AIGC{{/if}}</span>{{/if}}{{/if}}</div>
    {{#if page.description}}<p class="blog-post-desc">{{page.description}}</p>{{/if}}
  </header>
  <div class="blog-post-cols">
    <div class="blog-post-body">{{{page.content}}}</div>
    {{#if config.tocEnabled}}
    {{#if page.toc}}
      <aside class="blog-toc" aria-label="目录">
        <p class="blog-toc-title">目录</p>
        <ul class="blog-toc-list">
          {{#each page.toc}}
            <li class="blog-toc-item is-l{{this.level}}"><a href="#{{this.id}}">{{this.text}}</a></li>
          {{/each}}
        </ul>
      </aside>
    {{/if}}
    {{/if}}
  </div>
  <nav class="blog-pager">
    {{#if prev}}<a class="blog-pager-item" href="{{prev.url}}"><span class="blog-pager-tag">←</span><span>{{prev.title}}</span></a>{{/if}}
    {{#if next}}<a class="blog-pager-item is-next" href="{{next.url}}"><span>{{next.title}}</span><span class="blog-pager-tag">→</span></a>{{/if}}
  </nav>
</article>
  {{/if}}
{{/if}}
