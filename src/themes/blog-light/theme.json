{
  "id": "blog-light",
  "name": "手记 · 浅色",
  "version": "3.0.0",
  "author": "MogroWang Studio",
  "type": "blog",
  "description": "博客·浅色:纸面素栏,文章为流,日期为记。",
  "config": [
    {
      "key": "navMode",
      "label": "右上角导航",
      "type": "select",
      "default": "全部",
      "options": [
        "全部",
        "自定义"
      ]
    },
    {
      "key": "navPicked",
      "label": "选择要显示的文章或文件夹",
      "type": "navlist",
      "default": "",
      "visibleIf": {
        "key": "navMode",
        "equals": "自定义"
      }
    },
    {
      "key": "navMaxItems",
      "label": "右上角导航最多显示(项)",
      "type": "number",
      "default": 6,
      "min": 1,
      "max": 12,
      "step": 1
    },
    {
      "key": "accentColor",
      "label": "强调色",
      "type": "color",
      "default": "#4a5d82"
    },
    {
      "key": "contentWidth",
      "label": "正文宽度(px)",
      "type": "number",
      "default": 680,
      "min": 560,
      "max": 860,
      "step": 20
    },
    {
      "key": "navColumns",
      "label": "文章卡片并排(个)",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1
    },
    {
      "key": "coverHeight",
      "label": "封面图高度(px)",
      "type": "number",
      "default": 220,
      "min": 120,
      "max": 420,
      "step": 20
    },
    {
      "key": "topbarWidth",
      "label": "顶栏宽度(px)",
      "type": "number",
      "default": 920,
      "min": 600,
      "max": 1600,
      "step": 20
    },
    {
      "key": "postsPerPage",
      "label": "每页文章数",
      "type": "number",
      "default": 10,
      "min": 3,
      "max": 30,
      "step": 1
    },
    {
      "key": "bodyFont",
      "label": "正文字体",
      "type": "select",
      "default": "system",
      "options": [
        "system",
        "serif",
        "mono",
        "custom"
      ]
    },
    {
      "key": "customFont",
      "label": "自定义字体(font-family)",
      "type": "text",
      "default": "",
      "visibleIf": {
        "key": "bodyFont",
        "equals": "custom"
      }
    },
    {
      "key": "showLogo",
      "label": "显示 Logo",
      "type": "boolean",
      "default": true
    },
    {
      "key": "showTitle",
      "label": "显示站点标题",
      "type": "boolean",
      "default": true
    },
    {
      "key": "logoWidth",
      "label": "Logo 宽度(%)",
      "type": "number",
      "default": 100,
      "min": 50,
      "max": 300,
      "step": 5
    },
    {
      "key": "logoHeight",
      "label": "Logo 高度(%)",
      "type": "number",
      "default": 100,
      "min": 50,
      "max": 300,
      "step": 5
    },
    {
      "key": "logoRadius",
      "label": "Logo 圆角(px)",
      "type": "number",
      "default": 6,
      "min": 0,
      "max": 26,
      "step": 1
    },
    {
      "key": "logoHover",
      "label": "Logo 悬停反馈",
      "type": "select",
      "default": "无",
      "options": [
        "无",
        "淡化",
        "放大",
        "强调色"
      ]
    },
    {
      "key": "titleHover",
      "label": "标题悬停反馈",
      "type": "select",
      "default": "无",
      "options": [
        "无",
        "淡化",
        "强调色",
        "下划线"
      ]
    },
    {
      "key": "navHover",
      "label": "导航悬停反馈",
      "type": "select",
      "default": "加深",
      "options": [
        "无",
        "加深",
        "强调色",
        "下划线",
        "底色"
      ]
    },
    {
      "key": "cardShadow",
      "label": "卡片阴影",
      "type": "select",
      "default": "无",
      "options": [
        "无",
        "轻",
        "中",
        "深"
      ]
    },
    {
      "key": "cardShadowHover",
      "label": "卡片悬停阴影",
      "type": "select",
      "default": "轻",
      "options": [
        "无",
        "轻",
        "中",
        "深"
      ]
    },
    {
      "key": "loadingAnim",
      "label": "页面加载动画",
      "type": "select",
      "default": "关闭",
      "options": [
        "关闭",
        "转圈",
        "点点",
        "进度条"
      ]
    },
    {
      "key": "showDate",
      "label": "显示文章日期",
      "type": "boolean",
      "default": true
    },
    {
      "key": "pageTransition",
      "label": "页面过渡动画",
      "type": "select",
      "default": "淡入上浮",
      "options": [
        "关闭",
        "淡入",
        "淡入上浮",
        "缩放浮现",
        "滑入",
        "弹性浮现",
        "模糊聚焦",
        "翻页",
        "揭开"
      ]
    },
    {
      "key": "showFooterCredit",
      "label": "在底部显示由 Plainstruct 创建",
      "type": "boolean",
      "default": true
    }
  ]
}
