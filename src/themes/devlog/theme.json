{
  "id": "devlog",
  "name": "日志",
  "version": "2.1.0",
  "author": "MogroWang Studio",
  "type": "blog",
  "description": "极客日志风:等宽排印,日期戳记,终端余温。",
  "config": [
    {
      "key": "navMode",
      "label": "右上角导航",
      "type": "select",
      "default": "全部",
      "options": [
        "全部",
        "自定义"
      ]
    },
    {
      "key": "navPicked",
      "label": "选择要显示的文章或文件夹",
      "type": "navlist",
      "default": "",
      "visibleIf": {
        "key": "navMode",
        "equals": "自定义"
      }
    },
    {
      "key": "navMaxItems",
      "label": "右上角导航最多显示(项)",
      "type": "number",
      "default": 6,
      "min": 1,
      "max": 12,
      "step": 1
    },
    {
      "key": "accentColor",
      "label": "强调色",
      "type": "color",
      "default": "#e3b341"
    },
    {
      "key": "contentWidth",
      "label": "正文宽度(px)",
      "type": "number",
      "default": 720,
      "min": 520,
      "max": 900,
      "step": 20
    },
    {
      "key": "postsPerPage",
      "label": "每页文章数",
      "type": "number",
      "default": 10,
      "min": 3,
      "max": 30,
      "step": 1
    },
    {
      "key": "bodyFont",
      "label": "正文字体",
      "type": "select",
      "default": "mono",
      "options": [
        "system",
        "serif",
        "mono",
        "custom"
      ]
    },
    {
      "key": "customFont",
      "label": "自定义字体(font-family)",
      "type": "text",
      "default": "",
      "visibleIf": {
        "key": "bodyFont",
        "equals": "custom"
      }
    },
    {
      "key": "showDate",
      "label": "显示文章日期",
      "type": "boolean",
      "default": true
    },
    {
      "key": "pageTransition",
      "label": "页面过渡动画",
      "type": "select",
      "default": "淡入上浮",
      "options": [
        "关闭",
        "淡入",
        "淡入上浮",
        "缩放浮现",
        "滑入",
        "弹性浮现",
        "模糊聚焦",
        "翻页",
        "揭开"
      ]
    },
    {
      "key": "showFooterCredit",
      "label": "在底部显示由 Plainstruct 创建",
      "type": "boolean",
      "default": true
    }
  ]
}
