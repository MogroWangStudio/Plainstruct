<!doctype html>
<html lang="{{#if site.locale}}{{site.locale}}{{else}}zh-CN{{/if}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{#if page.fullTitle}}{{page.fullTitle}}{{else}}{{site.name}}{{/if}}</title>
  {{#if site.description}}<meta name="description" content="{{site.description}}">{{/if}}
  {{#if site.favicon}}<link rel="icon" href="{{site.favicon}}">{{/if}}
  <style>
    :root {
      --ps-accent: {{config.accentColor}};
      --ps-content-w: {{config.contentWidth}}px;
      --ps-nav-columns: {{config.navColumns}};
      --ps-cover-h: {{config.coverHeight}}px;
      --ps-topbar-w: {{config.topbarWidthPct}}%;
      --ps-topbar-deform-w: {{config.topbarShapeWidth}}px;
      --ps-topbar-dur: {{config.topbarDuration}}ms;
      --ps-topbar-ease-custom: {{config.topbarEaseCustom}};
      --ps-topbar-fill: color-mix(in srgb, {{config.topbarBgColor}} {{config.topbarFill}}%, transparent);
      --ps-topbar-blur: {{config.topbarBlur}}px;
      --ps-home-w: {{config.homeWidthPct}}%;
      --ps-card-fs: {{config.cardFontSizePc}}px;
      --ps-logo-w: {{config.logoWidthPx}}px;
      --ps-logo-h: {{config.logoHeightPx}}px;
      --ps-logo-r: {{config.logoRadius}}px;
    }
  </style>
  <link rel="stylesheet" href="{{asset "assets/style.css"}}">
  <!-- 3.8.0 正文字号与移动端卡片流:置于主题样式之后,桌面/移动分别生效 -->
  <style>
    body {
      font-size: {{config.fontSizePc}}px;
    }
    @media (max-width: 640px) {
      :root {
        --ps-nav-columns: {{config.navColumnsM}};
        --ps-cover-h: {{config.coverHeightM}}px;
        --ps-topbar-w: {{config.topbarWidthPctM}}%;
        --ps-card-fs: {{config.cardFontSizeM}}px;
      }
      body {
        font-size: {{config.fontSizeM}}px;
      }
    }
  </style>
</head>
  <body data-topbar-shape="{{config.topbarShape}}" data-topbar-ease="{{config.topbarEase}}" data-topbar-scroll-at="{{config.topbarScrollAt}}" class="blog font-{{config.bodyFont}}{{#if (eq config.pageTransition "淡入")}} ps-anim-fade{{/if}}{{#if (eq config.pageTransition "淡入上浮")}} ps-anim-rise{{/if}}{{#if (eq config.pageTransition "缩放浮现")}} ps-anim-zoom{{/if}}{{#if (eq config.pageTransition "滑入")}} ps-anim-slide{{/if}}{{#if (eq config.pageTransition "弹性浮现")}} ps-anim-spring{{/if}}{{#if (eq config.pageTransition "模糊聚焦")}} ps-anim-blur{{/if}}{{#if (eq config.pageTransition "翻页")}} ps-anim-flip{{/if}}{{#if (eq config.pageTransition "揭开")}} ps-anim-wipe{{/if}}"style="{{#if (eq config.bodyFont "custom")}}--ps-font-body: {{config.customFont}};{{/if}}{{#if config.cardShadowColor}}--ps-shadow-color: {{config.cardShadowColor}};{{/if}}{{#if config.cardShadowHoverColor}}--ps-shadow-hv-color: {{config.cardShadowHoverColor}};{{/if}}{{#if (eq config.cardShadow "自定义")}}--ps-shadow-custom: {{config.cardShadowX}}px {{config.cardShadowY}}px {{config.cardShadowBlur}}px {{config.cardShadowSpread}}px color-mix(in srgb, var(--ps-shadow-color, #000) {{config.cardShadowOpacity}}%, transparent);{{/if}}{{#if (eq config.cardShadowHover "自定义")}}--ps-shadow-hv-custom: {{config.cardShadowHoverX}}px {{config.cardShadowHoverY}}px {{config.cardShadowHoverBlur}}px {{config.cardShadowHoverSpread}}px color-mix(in srgb, var(--ps-shadow-hv-color, #000) {{config.cardShadowHoverOpacity}}%, transparent);{{/if}}{{#if (eq config.cardHoverEase "自定义")}}--ps-card-ease: cubic-bezier({{config.cardHoverEaseCustom}});{{/if}}--ps-card-dur: {{config.cardHoverDuration}}ms;" data-hv-logo="{{config.logoHover}}" data-hv-title="{{config.titleHover}}" data-hv-nav="{{config.navHover}}" data-shadow="{{config.cardShadow}}" data-shadow-hv="{{config.cardShadowHover}}" data-hv-card="{{config.cardHover}}" data-hv-ease="{{config.cardHoverEase}}" data-loading="{{config.loadingAnim}}" data-toc-style="{{config.tocStyle}}" data-toc-hover="{{config.tocHover}}" data-toc-click="{{config.tocClickAnim}}" data-toc-click-ease="{{config.tocClickEase}}" data-toc-click-ease-custom="{{config.tocClickEaseCustom}}" data-toc-click-dur="{{config.tocClickDuration}}" data-backtop="{{config.showBackTop}}" data-cover-fixed="{{config.coverFixedRatio}}" data-cover-ratio="{{config.coverRatio}}" data-backtop-pos="{{config.backTopPosition}}" data-topbar-mnav="{{config.topbarMobileMenu}}">
  {{#unless (eq config.loadingAnim "关闭")}}<div class="ps-loader" aria-hidden="true"><span class="ps-loader-spin"></span></div>{{/unless}}
  <header class="blog-topbar">
    <a class="blog-brand" href="{{asset "index.html"}}">
      {{#if config.showLogo}}{{#if site.logo}}<img class="blog-logo" src="{{site.logo}}" alt="{{site.name}}">{{/if}}{{/if}}
      {{#if config.showTitle}}<span class="blog-brand-text">
        <span class="blog-site-name">{{site.name}}</span>
        {{#if site.description}}<span class="blog-site-desc">{{site.description}}</span>{{/if}}
      </span>{{/if}}
    </a>
    {{#if config.topbarPageTitle}}{{#unless page.isHome}}<span class="blog-topbar-page">{{page.title}}</span>{{/unless}}{{/if}}
    {{#if nav}}
      <nav class="blog-nav" aria-label="站点导航">
        {{#each nav}}<a href="{{this.url}}"{{#if this.current}} class="current"{{/if}}>{{this.title}}</a>{{/each}}{{#if config.showArchive}}<a href="{{asset "archive/index.html"}}">归档</a>{{/if}}
      </nav>
    {{else if config.showArchive}}
      <nav class="blog-nav" aria-label="站点导航"><a href="{{asset "archive/index.html"}}">归档</a></nav>
    {{/if}}
    {{#if config.topbarMobileMenu}}<button type="button" class="blog-mnav-btn" aria-label="目录" aria-expanded="false"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/></svg></button>{{/if}}
  </header>
  {{#if config.topbarMobileMenu}}
  <nav class="blog-mnav" aria-label="站点导航">
    {{#each nav}}<a href="{{this.url}}"{{#if this.current}} class="current"{{/if}}>{{this.title}}</a>{{/each}}{{#if config.showArchive}}<a href="{{asset "archive/index.html"}}">归档</a>{{/if}}
  </nav>
  {{/if}}
  <main class="blog-main">
    {{> page}}
    <footer class="blog-footer">
      {{#if config.footerNote}}<p class="blog-footer-note">{{config.footerNote}}</p>{{/if}}
      {{#if page.footerLinks.length}}<nav class="blog-footer-links" aria-label="友情链接">{{#each page.footerLinks}}<a class="blog-footer-link" href="{{this.url}}" target="_blank" rel="noopener">{{#if this.icon}}<img class="blog-footer-link-icon" src="{{this.icon}}" alt="" loading="lazy">{{/if}}<span>{{this.name}}</span></a>{{/each}}</nav>{{/if}}
      {{#if config.footerBuild}}{{#if page.build}}<p class="blog-footer-build">{{page.build.text}}</p>{{/if}}{{/if}}
      {{#if config.showFooterCredit}}<a class="blog-footer-credit" href="https://github.com/MogroWang/Plainstruct" target="_blank" rel="noopener">由 Plainstruct 创建</a>{{/if}}
    </footer>
  </main>
</body>
</html>
