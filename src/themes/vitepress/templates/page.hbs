{{#if page.isHome}}
<section class="vp-home">
  {{#if config.showHero}}
  <header class="vp-hero">
    <h1 class="vp-hero-name">{{page.title}}</h1>
    {{#if site.description}}<p class="vp-hero-text">{{site.description}}</p>{{/if}}
    {{#if config.heroReadLabel}}
    {{#with (lookup nav 0)}}{{#if url}}
    <div class="vp-hero-actions"><a class="vp-hero-btn" href="{{url}}">{{../config.heroReadLabel}}</a></div>
    {{/if}}{{/with}}
    {{/if}}
  </header>
  {{else}}
  <h1 class="vp-doc-title">{{page.title}}</h1>
  {{/if}}
  {{#if page.content}}<div class="vp-doc-body is-home">{{{page.content}}}</div>{{/if}}
</section>
{{else}}
<article class="vp-doc">
  <header class="vp-doc-head">
    {{#if page.title}}<h1 class="vp-doc-title">{{page.title}}</h1>{{/if}}
    <div class="vp-doc-meta">{{#if config.showDate}}{{#if page.date}}<time class="vp-doc-date">{{page.date}}</time>{{/if}}{{/if}}{{#if config.showAuthor}}{{#if page.author}}<span class="vp-doc-author">{{page.author}}</span>{{/if}}{{/if}}{{#if config.showAigc}}{{#if page.aigc}}<span class="vp-aigc" data-aigc="{{page.aigc}}">{{#if (eq page.aigc "present")}}本文由 AI 辅助生成{{else}}本文无任何 AIGC{{/if}}</span>{{/if}}{{/if}}</div>
    {{#if page.description}}<p class="vp-doc-desc">{{page.description}}</p>{{/if}}
  </header>
  {{#if page.content}}<div class="vp-doc-body">{{{page.content}}}</div>{{/if}}
  <nav class="vp-pager">
    {{#if prev}}<a class="vp-pager-item is-prev" href="{{prev.url}}"><span class="vp-pager-tag">← 上一页</span><span class="vp-pager-title">{{prev.title}}</span></a>{{/if}}
    {{#if next}}<a class="vp-pager-item is-next" href="{{next.url}}"><span class="vp-pager-tag">下一页 →</span><span class="vp-pager-title">{{next.title}}</span></a>{{/if}}
  </nav>
</article>
{{/if}}
