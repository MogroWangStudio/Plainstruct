{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plainstruct",
  "mainBinaryName": "plainstruct",
  "version": "3.2.0",
  "identifier": "com.mws.plainstruct",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "素构 Plainstruct",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "visible": false,
        "resizable": true,
        "center": true,
        "skipTaskbar": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 7, "y": 18 },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": "default-src 'self'; img-src 'self' data: blob: http://site.localhost site: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:5173 ws://localhost:5174 http://localhost:5173; frame-src 'self' http://site.localhost site: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
